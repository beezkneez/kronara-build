# Kronara Demo — Environment Variables
# Copy this to .env or set these in your Railway deployment

# Database
DATABASE_URL=postgresql://...

# Brand
BRAND_NAME=Kronara
BRAND_SUB=Your Studio Operating System
BRAND_SITE=https://kronara.app
BRAND_LOGO_URL=/logo.png
BRAND_ICON_192=/icon-192.png
BRAND_ICON_512=/icon-512.png
BRAND_ICON_MASKABLE=/icon-maskable-512.png
BRAND_COLOR_PRIMARY=#D9AE68
BRAND_COLOR_ACCENT=#C08A42
BRAND_COLOR_DARK_BG=#070A0F
BRAND_DEFAULT_THEME=kronara

# Demo Mode
DEMO_MODE=true

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=Kronara <support@kronara.app>

# App Domain
APP_DOMAIN=kronara.app
APP_URL=https://app.kronara.app

# QuickBooks Online Integration (optional)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=https://app.kronara.app/api/qbo/callback
